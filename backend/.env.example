GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# JSON array required by pydantic-settings
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173","https://query-mind-frontend.vercel.app","https://query-mind-sql.vercel.app"]

# Optional tuning
# MAX_RETRIES=3
# GROQ_TEMPERATURE=0.0

# Optional local database path override. Defaults to backend/querymind.db,
# or /tmp/querymind.db when running on Vercel. See app/database.py.
# SQLITE_DB_PATH=./querymind.db
